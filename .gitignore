# Dependencies
node_modules/

# Frontend build output (embedded into the worker at deploy time)
frontend/dist/

# Generated worker asset bundle (rebuilt by generate-assets.js on every deploy)
worker/src/assets.js

# Wrangler local state
.wrangler/

# Logs
*.log
wrangler-dev.log

# Local curl cookie jars (never commit session tokens)
ck.txt
cookies.txt

# Local env / secrets — never commit credentials
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db

# Historical export snapshots (deleted from repo 2026-09-23 as stale
# duplicates once push-to-deploy went live; kept ignored in case one reappears)
exports/

# Editor
.vscode/
.idea/